import heapq

INF = float('inf')


def reduce_matrix(mat):
    m = [row[:] for row in mat]
    n = len(m)
    cost = 0

    # Row reduction
    for i in range(n):
        row_min = min(m[i])
        if row_min != INF and row_min > 0:
            cost += row_min
            for j in range(n):
                if m[i][j] != INF:
                    m[i][j] -= row_min

    # Column reduction
    for j in range(n):
        col_min = min(m[i][j] for i in range(n))
        if col_min != INF and col_min > 0:
            cost += col_min
            for i in range(n):
                if m[i][j] != INF:
                    m[i][j] -= col_min

    return m, cost


def tsp_branch_bound(cost_matrix):
    n = len(cost_matrix)

    reduced, initial_bound = reduce_matrix(cost_matrix)

    # (bound, cost, path, visited)
    pq = []
    heapq.heappush(pq, (initial_bound, 0, [0], {0}))

    best_cost = INF
    best_path = []

    while pq:
        bound, cost, path, visited = heapq.heappop(pq)

        if bound >= best_cost:
            continue

        if len(path) == n:
            total_cost = cost + cost_matrix[path[-1]][0]

            if total_cost < best_cost:
                best_cost = total_cost
                best_path = path + [0]

            continue

        current = path[-1]

        for city in range(n):
            if city not in visited:
                new_cost = cost + cost_matrix[current][city]

                if new_cost >= best_cost:
                    continue

                new_path = path + [city]
                new_visited = visited | {city}

                remaining = [
                    cost_matrix[city][j]
                    for j in range(n)
                    if j not in new_visited
                ]

                if remaining:
                    estimate = min(remaining)
                else:
                    estimate = cost_matrix[city][0]

                new_bound = new_cost + estimate

                heapq.heappush(
                    pq,
                    (new_bound, new_cost, new_path, new_visited)
                )

    return best_path, best_cost


cost_matrix = [
    [INF, 10, 8, 5, 7],
    [10, INF, 10, 5, 6],
    [8, 10, INF, 8, 9],
    [5, 5, 8, INF, 6],
    [7, 6, 9, 6, INF]
]

cities = ['A', 'B', 'C', 'D', 'E']

print("5-City TSP - Cost Matrix:")
for row in cost_matrix:
    print(row)

path, cost = tsp_branch_bound(cost_matrix)

print("\nOptimal Tour:", end=" ")

for i, city in enumerate(path):
    print(cities[city], end="")
    if i < len(path) - 1:
        print(" -> ", end="")

print("\nMinimum Cost:", cost)
